# ===== LLM 提供商 =====
# 默认使用硅基流动（OpenAI 兼容协议），仅需配置 SILICONFLOW_API_KEY 即可运行
DEFAULT_LLM_PROVIDER=siliconflow

# 硅基流动（默认）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_MODEL=Qwen/Qwen3.5-122B-A10B
# SILICONFLOW_ENABLE_THINKING=false   # 思考模型开关，专利格式化生成建议关闭

# OpenAI（可选）
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# Anthropic（可选，需单独安装 anthropic SDK）
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ===== 搜索 API（可选，用于专利检索）=====
# SERPAPI_API_KEY=your_serpapi_key_here
# EXA_API_KEY=your_exa_key_here

# ===== 运行与可观测（可选）=====
# LLM_MAX_RETRIES=3
# PARSE_MAX_CHARS=12000
# LOG_LEVEL=INFO

# ===== Agentic RAG（可选，默认关闭以控制成本）=====
# RAG_ENABLED=false          # true 时检索走「查询改写 + 迭代检索」Agent

# ===== 合规校验节点 verify（可选）=====
# VERIFY_USE_LLM=false       # true 时校验增加 1 次 LLM 语义判断
# VERIFY_ENFORCE=false       # true 时校验不通过自动回退重写权项（限 1 次）

# ===== token 成本计量（单价：元/百万 tokens，硅基流动 Qwen3.5-122B-A10B 已核实）=====
# LLM_INPUT_PRICE_PER_1M=0.8
# LLM_OUTPUT_PRICE_PER_1M=6.4

# ===== 服务化部署（可选）=====
# SERVE_HOST=0.0.0.0         # HTTP 服务监听地址
# SERVE_PORT=8000            # HTTP 服务端口
# SERVE_MAX_WORKERS=3        # 并发生成任务数上限
# SERVE_CHECKPOINT_DIR=jobs/checkpoints   # 断点续跑 SQLite 目录
# SERVE_OUTPUT_ROOT=output   # 生成产物根目录
